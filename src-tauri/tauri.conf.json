{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "st6-trainer",
  "identifier": "com.github.bindi-mo.st6-trainer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "st6-trainer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "st6_scanner.dll",
      "st6_llm_worker.exe",
      "config/*.json",
      "templates/**/*",
      "scripts/requirements.txt",
      "scripts/extract_templates.py",
      "scripts/sf6_frame_data_processor.py",
      "frame_data/*.json"
    ]
  }
}